{
  "name": "sightline",
  "productName": "Sightline",
  "version": "1.0.2",
  "description": "Companion-приложение для War Thunder: разбор кил-фида, статистика боёв и игроков. Использует официальный локальный API игры (127.0.0.1:8111). Не аффилировано с Gaijin Entertainment.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "test": "node --test \"test/*.test.js\"",
    "harness": "node scripts/harness/build.js",
    "dist": "electron-builder --win --publish never",
    "icons": "node scripts/make-ico.js"
  },
  "author": "",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feelyamon/Sightline.git"
  },
  "bugs": {
    "url": "https://github.com/Feelyamon/Sightline/issues"
  },
  "homepage": "https://sightline.feelyamon.ru/",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.feelyamon.sightline",
    "productName": "Sightline",
    "files": [
      "src/**/*",
      "package.json",
      "!**/__*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
