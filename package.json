{
  "name": "sightline",
  "productName": "Sightline",
  "version": "0.2.0",
  "description": "Companion-приложение для War Thunder: разбор кил-фида, статистика боёв и игроков. Использует официальный локальный API игры (127.0.0.1:8111). Не аффилировано с Gaijin Entertainment.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "test": "node --test \"test/*.test.js\"",
    "harness": "node scripts/harness/build.js",
    "dist": "electron-builder --win --publish never"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.feelyamon.sightline",
    "productName": "Sightline",
    "files": [
      "src/**/*",
      "package.json",
      "!**/__*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png"
    }
  }
}
